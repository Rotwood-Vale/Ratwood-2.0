/datum/unit_test/rous_taming/Run()
	var/turf/caster_turf = run_loc_floor_bottom_left
	var/turf/rat_turf = get_step(caster_turf, EAST)
	var/mob/living/carbon/human/caster = allocate(/mob/living/carbon/human/consistent, caster_turf)
	var/mob/living/simple_animal/hostile/retaliate/rogue/bigrat/rat = allocate(/mob/living/simple_animal/hostile/retaliate/rogue/bigrat, rat_turf)
	var/obj/effect/proc_holder/spell/targeted/roustame/spell = allocate(/obj/effect/proc_holder/spell/targeted/roustame)
	TEST_ASSERT_NOTNULL(rat.ai_controller, "Rous should have an AI controller")
	rat.ai_controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, caster)
	rat.ai_controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET_HIDING_LOCATION, caster_turf)
	rat.ai_controller.set_blackboard_key(BB_BASIC_MOB_RETALIATE_LIST, list(caster))

	TEST_ASSERT(spell.cast(list(), caster), "Tame Rous should succeed on a nearby Rous")
	TEST_ASSERT(rat.tame, "Rous should be marked tame")
	TEST_ASSERT(caster in rat.friends, "Caster should be added to the Rous's friends")
	TEST_ASSERT(rat.ai_controller.blackboard[BB_BASIC_MOB_TAMED], "Rous AI should be marked tame")
	TEST_ASSERT_NULL(rat.ai_controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET], "Rous AI target should be cleared")
	TEST_ASSERT_NULL(rat.ai_controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET_HIDING_LOCATION], "Rous AI hiding target should be cleared")
	TEST_ASSERT_NULL(rat.ai_controller.blackboard[BB_BASIC_MOB_RETALIATE_LIST], "Rous AI retaliation list should be cleared")

	rat.ai_controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, caster)
	rat.ai_controller.set_blackboard_key(BB_BASIC_MOB_RETALIATE_LIST, list(caster))
	TEST_ASSERT(spell.cast(list(), caster), "Tame Rous should also calm an already tame Rous")
	TEST_ASSERT_NULL(rat.ai_controller.blackboard[BB_BASIC_MOB_CURRENT_TARGET], "Repeated cast should clear the AI target")
	TEST_ASSERT_NULL(rat.ai_controller.blackboard[BB_BASIC_MOB_RETALIATE_LIST], "Repeated cast should clear the AI retaliation list")

/datum/unit_test/rous_riding_ai/Run()
	var/turf/rat_turf = run_loc_floor_bottom_left
	var/mob/living/simple_animal/hostile/retaliate/rogue/bigrat/rat = allocate(/mob/living/simple_animal/hostile/retaliate/rogue/bigrat, rat_turf)
	var/mob/living/carbon/human/rider = allocate(/mob/living/carbon/human/consistent, rat_turf)
	TEST_ASSERT_NOTNULL(rat.ai_controller, "Rous should have an AI controller")
	rat.tamed()
	rat.ai_controller.set_ai_status(AI_STATUS_ON)
	rat.ai_controller.set_blackboard_key(BB_BASIC_MOB_CURRENT_TARGET, rider)
	rat.ai_controller.queue_behavior(/datum/ai_behavior/basic_melee_attack, BB_BASIC_MOB_CURRENT_TARGET, BB_TARGETTING_DATUM, BB_BASIC_MOB_CURRENT_TARGET_HIDING_LOCATION)
	TEST_ASSERT(length(rat.ai_controller.current_behaviors), "Rous should have an active behavior before mounting")

	TEST_ASSERT(rat.buckle_mob(rider, TRUE), "Rider should buckle to the Rous")
	TEST_ASSERT_EQUAL(rat.ai_controller.ai_status, AI_STATUS_OFF, "Rous AI should pause while mounted")
	TEST_ASSERT(!length(rat.ai_controller.current_behaviors), "Mounting should cancel active AI behaviors")
	rat.ai_controller.reset_ai_status()
	TEST_ASSERT_EQUAL(rat.ai_controller.ai_status, AI_STATUS_OFF, "AI status resets should not resume a mounted Rous")

	TEST_ASSERT(rat.unbuckle_mob(rider, TRUE), "Rider should unbuckle from the Rous")
	TEST_ASSERT_EQUAL(rat.ai_controller.ai_status, rat.ai_controller.get_expected_ai_status(), "Rous AI should return to its expected status")
	TEST_ASSERT_NOTEQUAL(rat.ai_controller.ai_status, AI_STATUS_OFF, "A living unmounted Rous should resume its AI")
