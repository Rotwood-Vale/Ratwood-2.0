/datum/unit_test/silk_bed
	var/list/changed_turfs = list()

/datum/unit_test/silk_bed/Destroy()
	for(var/turf/T as anything in changed_turfs)
		T.ChangeTurf(/turf/open/floor/rogue/blocks)
	return ..()

/datum/unit_test/silk_bed/Run()
	var/turf/center = get_step(get_step(run_loc_floor_bottom_left, NORTH), EAST)
	var/obj/structure/bed/rogue/silk/bed = allocate(/obj/structure/bed/rogue/silk, center)
	STOP_PROCESSING(SSobj, bed)
	TEST_ASSERT_EQUAL(bed.sleepy, 2, "An unwebbed bed should match a bedroll.")
	TEST_ASSERT_EQUAL(bed.required_web_tiles, 8, "All eight floor neighbors should count.")
	TEST_ASSERT_NULL(bed.GetComponent(/datum/component/hiding_spot), "A silk bed must not hide occupants inside itself.")
	var/list/webs = list()
	for(var/turf/T in RANGE_TURFS(1, center))
		if(T == center)
			continue
		var/web_type = webs.len % 2 ? /obj/structure/spider/stickyweb/thin : /obj/structure/spider/stickyweb/thick
		webs += allocate(web_type, T)
	bed.refresh_comfort()
	TEST_ASSERT_EQUAL(bed.sleepy, 3, "A complete mixed web ring should upgrade the bed.")
	TEST_ASSERT_EQUAL(bed.icon_state, "complete", "The complete stage should use its own icon.")
	var/obj/structure/spider/stickyweb/missing = webs[1]
	var/turf/missing_turf = get_turf(missing)
	qdel(missing)
	bed.refresh_comfort()
	TEST_ASSERT_EQUAL(bed.sleepy, 2, "Deleting one required web must downgrade comfort.")
	TEST_ASSERT_EQUAL(bed.icon_state, "basic", "Deleting a web must downgrade the icon too.")
	var/obj/structure/spider/stickyweb/existing = webs[2]
	allocate(/obj/structure/spider/stickyweb/thin, get_turf(existing))
	bed.refresh_comfort()
	TEST_ASSERT_EQUAL(bed.webbed_tiles, 7, "Duplicate webs cannot replace a missing tile.")
	var/obj/structure/chair/obstacle = allocate(/obj/structure/chair, missing_turf)
	bed.refresh_comfort()
	TEST_ASSERT_EQUAL(bed.required_web_tiles, 8, "Furniture must not reduce the floor requirement.")
	qdel(obstacle)
	var/turf/wall = missing_turf.ChangeTurf(/turf/closed/wall/mineral/rogue/wood)
	changed_turfs += wall
	bed.refresh_comfort()
	TEST_ASSERT_EQUAL(bed.sleepy, 3, "A wall should not require webbing.")
	TEST_ASSERT_EQUAL(bed.required_web_tiles, 7, "Only surrounding floors should count.")
	for(var/turf/T in RANGE_TURFS(1, center))
		if(T == center || T == wall)
			continue
		changed_turfs += T.ChangeTurf(/turf/closed/wall/mineral/rogue/wood)
	bed.refresh_comfort()
	TEST_ASSERT_EQUAL(bed.sleepy, 2, "A completely enclosed bed cannot upgrade without a webbed floor tile.")
	var/obj/effect/proc_holder/spell/self/spin_silk_bed/spell = allocate(/obj/effect/proc_holder/spell/self/spin_silk_bed)
	TEST_ASSERT(!spell.can_place(center), "Cannot place a second bed on the same tile.")
	var/mob/living/carbon/human/sleeper = allocate(/mob/living/carbon/human, center)
	TEST_ASSERT(bed.buckle_mob(sleeper, force = TRUE), "Bed should accept a sleeper.")
	TEST_ASSERT(bed.CanPass(sleeper, center), "Its occupant must bypass web obstruction.")
	qdel(bed)
	TEST_ASSERT_NULL(sleeper.buckled, "Deleting a bed must release its sleeper.")
