// ============================================================================
// modular_z121/vices/facial_blindness.dm
// 自定义恶习（Custom Vice / 恶习）：脸盲症 / Facial Blindness
// ----------------------------------------------------------------------------
// 需求（为什么要做这个文件）：
//   实现一个全新的"脸盲症（Facial Blindness）"恶习，其核心设定为：
//     · "在你眼里，每个人都是陌生人。"（Everyone seems unknown to you.）
//     · "你无从记住别人的长相。"（You have no way of remembering other people's faces.）
//   即——患者【看不出别人是谁】：任何人在他眼中都显示为"陌生人"；并且他【记不住脸】：
//   无论见过多少次、被介绍过多少回，都无法在脑海里建立起对他人面孔/身份的长期记忆。
//
// 落地到引擎的两个抓手（为什么选这两个机制）：
//   抓手 A —— "看谁都是陌生人"：
//     引擎在 code/modules/mob/living/carbon/human/examine.dm 的 human/examine() 里，
//     对【观察者】做了判定：
//         if(isliving(user))
//             if(HAS_TRAIT(L, TRAIT_PROSOPAGNOSIA))
//                 obscure_name = TRUE
//     一旦观察者带有 TRAIT_PROSOPAGNOSIA（"脸盲/面孔失认"特性），他查看任何人时其姓名
//     都会被打码为"an unknown <名字>"，并且【不会】走到 on_examine_face() 分支（即不会
//     因为"看了脸"而把对方记成熟人）。这正是"看谁都是陌生人"的精准实现。本恶习要做的，
//     就是把这条原本游戏里没有任何来源会授予的特性，授予到患者身上。
//   抓手 B —— "记不住别人的长相"：
//     引擎用 mind.known_people（见 code/datums/mind.dm）记录"我认得的人"——它同时驱动了
//     "在聊天里把熟人的声音/名字认出来"等识别逻辑（见 code/game/say.dm 对 known_people 的
//     使用）。换言之，known_people 就是角色对他人"面孔/身份"的长期记忆库。脸盲症患者既然
//     "记不住脸"，那就让这本记忆库永远攒不起来：周期性地用 mind.unknow_all_people() 清空它。
//     这样即便经由其它途径（被人介绍、特殊职业互认等）短暂写入了熟人，也会很快被遗忘，
//     完美对应"无从记住别人长相"的设定。
//
// 为什么"抓手 A + 抓手 B"要同时做（为什么不只做一个）：
//   · 只做 A（给特性）：examine 会显示陌生人，但 known_people 仍可能被其它系统写入，
//     从而在聊天识别等处"认出"某人，与"记不住脸"相矛盾。
//   · 只做 B（清记忆）：known_people 被清空了，但 examine 分支并不读取 known_people，
//     而是读取 TRAIT_PROSOPAGNOSIA，故查看他人时姓名仍会正常显示，"看谁都是陌生人"落空。
//   两者一个管"看"（examine 显示）、一个管"记"（长期记忆），合起来才完整覆盖需求两句话。
//
// 为什么这是一个"恶习（Vice）"而不是"美德（Virtue）"：
//   本游戏里玩家可选的"恶习/缺陷"是 /datum/charflaw 的子类（见
//   code/datums/character_flaw/_character_flaw.dm 与角色定制菜单
//   code/modules/client/vices_menu.dm 的"恶习选择"区域）；/datum/virtue 是另一套"美德"系统。
//   需求要的是"Vice（恶习）"，故本恶习实现为 /datum/charflaw 的子类型。
//
// 合规性说明（为什么所有逻辑都放在本文件内）：
//   按硬性约束，自定义内容只能放在 modular_z121 目录下，且不得改动该目录之外的任何文件。
//   本文件通过"继承已有基类、追加子类型 / 追加运行时登记"的方式接入引擎（属于"追加"而非
//   "修改"核心文件），不改动 modular_z121 之外的任何源文件。唯一需要触碰的另一处是同在
//   modular_z121 内的 bootstrap/custom_bootstrap.dm，用于把本恶习登记进"可选恶习列表"，
//   详见文件末尾的登记说明。
//
// 依赖（均为引擎已有内容，本文件只调用 / 继承，不修改其源文件）：
//   - /datum/charflaw                    恶习基类，提供 on_mob_creation/flaw_on_life/on_removal 钩子。
//   - flaw_on_life()                     每个生命 tick 由 human/life.dm 对每个已装备非 ephemeral 恶习调用。
//   - TRAIT_PROSOPAGNOSIA                "面孔失认"特性（code/__DEFINES/traits.dm），examine 据此打码姓名。
//   - ADD_TRAIT / REMOVE_TRAIT / HAS_TRAIT  带来源标签的特性增删查（code/__DEFINES/traits.dm 宏）。
//   - /datum/mind/known_people           角色的"熟人/面孔记忆"库（code/datums/mind.dm）。
//   - /datum/mind/unknow_all_people()    一键清空 known_people（code/datums/mind.dm）。
//   - GLOB.character_flaws               角色定制界面"可选恶习"列表（用于登记本恶习）。
//
// 加载：本文件需在 modular_z121/_load.dm 中以 #include 引入（已在该文件追加）。
// ============================================================================


// ----------------------------------------------------------------------------
// 特性来源标签（#define）。
// 为什么要用一个【唯一且固定】的来源标签：引擎的特性系统是"带来源(source)的引用计数"，
//   ADD_TRAIT 与 REMOVE_TRAIT 必须使用【完全相同】的来源字符串，移除才能精确对应、不误删
//   其它来源（例如某种族/法术也恰好赋予了同名特性）授予的同一特性。这里用恶习的类型路径
//   字符串作为来源，天然唯一、自解释，且与本项目其它恶习（如 greedy 用 "[type]"）写法一致。
// ----------------------------------------------------------------------------
#define FACIAL_BLINDNESS_TRAIT_SOURCE "charflaw_facial_blindness"


// ----------------------------------------------------------------------------
// 恶习定义：脸盲症（Facial Blindness）
// 为什么直接继承 /datum/charflaw：脸盲症是一种"被动持续生效"的性格缺陷——授予一个特性、
//   再靠 flaw_on_life 周期性地"擦除面孔记忆"即可驱动其全部逻辑，不需要任何主动技能/读条，
//   因此最基础的 /datum/charflaw 父类就足够，无需更复杂的基类。
// ----------------------------------------------------------------------------
/datum/charflaw/facial_blindness
	name = "脸盲症"                                                            // 角色定制菜单中显示的恶习名（Facial Blindness）。
	// 为什么这样写描述：用第一人称把两条核心设定讲清楚——在我眼里人人都是陌生人，且我永远
	//   记不住别人的脸（哪怕反复见面、被介绍）。让玩家选择前就明白这份缺陷的具体后果。
	desc = "在我眼里，每一个人都是陌生人——我天生认不出面孔。\
			无论与谁打过多少次照面、被引荐过多少回，我都无从把一张脸和一个人对应起来；\
			那些本该熟悉的容貌，转眼就从我的记忆里褪去，重新变回一个个'不认识的人'。"

	// 为什么用 last_check 做节流：flaw_on_life 每个生命 tick 都会被调用（非常频繁），而
	//   "擦除面孔记忆"涉及清空一个关联列表，没必要每 tick 都做。参照本项目 paranoid/greedy
	//   等恶习的写法，用时间戳把实际处理限制为每隔若干秒一次，降低无谓开销。
	var/last_check = 0
	// 为什么把检测间隔抽成变量：便于统一调整节奏，也让"为什么是这个频率"一目了然。
	//   5 秒一次：足够频繁（短暂被写入的熟人会很快被遗忘），又不会造成性能负担。
	var/check_interval = 5 SECONDS
	// 为什么记录"下次可发遗忘提示的时间"：擦除记忆若每次都给玩家发提示会刷屏；用一个独立的
	//   冷却时间戳，让"某人的样貌从我脑海中淡去……"这类氛围提示偶尔出现一次即可，既有代入感
	//   又不打扰。仅在"本次确实擦掉了已记住的人"时才计入这条提示。
	var/next_forget_msg = 0
	// 为什么把遗忘提示冷却抽成变量：与 check_interval 同理，集中便于调节，且自解释。
	//   2 分钟一次：氛围点到为止，不喧宾夺主。
	var/forget_msg_cooldown = 2 MINUTES


// ----------------------------------------------------------------------------
// 创建钩子：恶习刚挂到角色身上时
// 为什么重写 on_mob_creation：这是"恶习上身即刻生效"的标准入口。脸盲症的核心抓手 A
//   （授予 TRAIT_PROSOPAGNOSIA）只作用于 mob 本身、不依赖 mind，因此可以在这里立即施加，
//   让玩家一进入游戏就"看谁都是陌生人"。抓手 B（清空面孔记忆）则依赖 mind，可能此刻尚未
//   就绪，故只在 mind 已存在时顺手清一次，真正的"持续遗忘"交给 flaw_on_life 周期处理。
// ----------------------------------------------------------------------------
/datum/charflaw/facial_blindness/on_mob_creation(mob/user)
	. = ..()                                                                   // 先跑基类逻辑（当前为空实现，保留以兼容未来扩展）。

	// 为什么做空值校验：防御式编程——理论上 user 必有，但缺失时直接返回可避免空引用报错。
	if(!user)
		return

	// 抓手 A：授予"面孔失认"特性。
	// 为什么用带来源标签的 ADD_TRAIT：见文件顶部 FACIAL_BLINDNESS_TRAIT_SOURCE 的说明——
	//   带来源的增删能保证移除时精确对应，不会误删其它系统授予的同名特性。
	// 为什么先判 HAS_TRAIT 再加：避免在极端重复调用下对同一来源重复登记（虽然引擎可容忍，
	//   但显式去重更稳健，也让意图更清晰）。
	if(!HAS_TRAIT(user, TRAIT_PROSOPAGNOSIA))
		ADD_TRAIT(user, TRAIT_PROSOPAGNOSIA, FACIAL_BLINDNESS_TRAIT_SOURCE)

	// 抓手 B（首次）：若 mind 已就绪，立刻清空一次面孔记忆，避免角色"带着旧记忆"开局。
	// 为什么要判 mind：known_people 挂在 mind 上；on_mob_creation 触发时 mind 往往尚未就绪
	//   （参见本项目 badsight/yandere 等恶习对"此刻还没有 mind"的注释），故仅在已就绪时处理，
	//   未就绪则不强求——后续 flaw_on_life 会反复补清。
	if(user.mind)
		user.mind.unknow_all_people()

	// 给玩家一段私密的"自我认知"提示，明确告知这份缺陷已经生效（只有本人看得到）。
	to_chat(user, span_notice("我望向周遭的每一张脸，却没有一张能与'某个人'对上号——\
		在我眼中，人人都是陌生人，而且我注定记不住他们的模样。"))


// ----------------------------------------------------------------------------
// 核心驱动：每生命 tick 的处理
// 为什么重写 flaw_on_life：这是恶习系统提供的"周期性心跳"钩子（human/life.dm 对每个非
//   ephemeral 的已装备恶习调用），是实现"持续遗忘面孔 + 兜底维持特性"的标准位置。
// ----------------------------------------------------------------------------
/datum/charflaw/facial_blindness/flaw_on_life(mob/user)
	. = ..()                                                                   // 先跑基类逻辑。

	// 为什么做类型校验：恶习理论上只挂在人类身上，但 flaw_on_life 形参是泛化 mob；一次
	//   ishuman 守门可避免对非人类执行人类专属逻辑而报错（健壮性）。
	if(!ishuman(user))
		return
	var/mob/living/carbon/human/H = user                                       // 取得人类引用，便于读取 mind 等。

	// 为什么死亡时不处理：对尸体计较"认不认得脸"既无意义，也没有"看/记"的行为发生；
	//   直接跳过，待其复活/转生后由后续 tick 自然恢复处理（特性仍在身上，不受影响）。
	if(H.stat == DEAD)
		return

	// 节流：未到检测间隔就直接返回，省去频繁的列表清空与运算。
	if(world.time < last_check + check_interval)
		return
	last_check = world.time                                                    // 记录本次检测时间，作为下次节流基准。

	// —— 兜底维持抓手 A ——
	// 为什么要在心跳里再确认一次特性还在：理论上 on_mob_creation 已授予，但中途可能有其它
	//   系统（如某些"清除全部特性"的效果）把它抹掉。脸盲症是持续性缺陷，必须保证特性常驻，
	//   故发现缺失就用相同来源补回，确保"看谁都是陌生人"始终成立。
	if(!HAS_TRAIT(H, TRAIT_PROSOPAGNOSIA))
		ADD_TRAIT(H, TRAIT_PROSOPAGNOSIA, FACIAL_BLINDNESS_TRAIT_SOURCE)

	// —— 持续执行抓手 B ——
	// 为什么把"擦除面孔记忆"抽成独立 proc：把"遗忘逻辑"与心跳主流程解耦，逻辑清晰、便于维护。
	forget_all_faces(H)


// ----------------------------------------------------------------------------
// 擦除面孔记忆（抓手 B 的具体落地）
// 为什么单独成 proc：把"清空 known_people + 适度的氛围提示"封装起来，既便于 on_mob_creation
//   与 flaw_on_life 复用思路，也让职责单一、易读。
// 为什么"只在记忆非空时才清并提示"：known_people 为空时清空是空操作、提示更是无意义刷屏；
//   仅当确实记住了人（length>0）时才执行"遗忘"，既省开销，也让氛围提示真正对应"刚刚把某个
//   本已记住的人忘掉了"的时刻。
// ----------------------------------------------------------------------------
/datum/charflaw/facial_blindness/proc/forget_all_faces(mob/living/carbon/human/H)
	// 防御式校验：无效人类直接返回，避免空引用（本 proc 也可能被独立调用）。
	if(!istype(H))
		return
	// mind 未就绪 -> 无 known_people 可清，直接返回，等下次心跳（那时 mind 多半已就绪）。
	// 为什么用 ?. ：安全访问——即便 mind 为 null 也不会报错，length(null) 安全地得到 0。
	if(!H.mind)
		return

	// 读取当前记住的人数。为什么先读再决定：据此判断"是否真有需要遗忘的对象"，
	//   从而决定要不要清空、要不要给氛围提示。
	var/remembered_count = length(H.mind.known_people)
	if(!remembered_count)                                                      // 本就没记住任何人 -> 无需遗忘，直接返回。
		return

	// 真正执行"遗忘"：一键清空面孔记忆库。
	// 为什么用 unknow_all_people()：这是引擎在 mind.dm 里提供的"清空 known_people"标准接口
	//   （known_people = list()），语义明确、最不易出错；它会一并清掉熟人对应的声音颜色等
	//   识别信息，使聊天等处也无法再"认出"这些人——这正是"记不住脸/认不出人"的完整表现。
	H.mind.unknow_all_people()

	// 适度的氛围提示：仅在冷却结束后给一次，避免刷屏。
	// 为什么放在清空之后：先确认这次确实有"被遗忘的对象"（remembered_count>0 已保证），
	//   再决定是否提示；用独立冷却 next_forget_msg 控制频率，让提示像"记忆悄然褪色"般偶现。
	if(world.time >= next_forget_msg)
		next_forget_msg = world.time + forget_msg_cooldown                     // 重置遗忘提示冷却。
		to_chat(H, span_warning("那些刚刚还有些眼熟的面孔，又一次从我的记忆里悄然褪去，\
			重新变回一张张陌生的脸……"))


// ----------------------------------------------------------------------------
// 卸载清理：当恶习被移除时彻底善后
// 为什么重写 on_removal：恶习可能中途被移除（管理员操作、转生等），此时必须撤销本恶习
//   施加的持续效果——把"面孔失认"特性收回，否则会留下"恶习已没了、却还看谁都是陌生人"的
//   残留，污染玩家状态。
// 为什么【不】恢复 known_people：被遗忘的熟人记忆属于"已发生的信息丢失"，无法也不应"凭空
//   补回"（我们并没有保存它）；而且恶习移除后玩家本就会自然地重新认识他人，known_people
//   会照常重新积累。故这里只需停止"持续遗忘"（移除特性 + 不再有心跳擦除），无需也不该
//   尝试重建记忆（最小副作用原则）。
// ----------------------------------------------------------------------------
/datum/charflaw/facial_blindness/on_removal(mob/user)
	. = ..()                                                                   // 先跑基类清理逻辑。
	if(!user)                                                                  // 防御式校验：无效持有者直接返回。
		return

	// 收回"面孔失认"特性——必须用与授予时【完全相同】的来源标签，才能精确移除我们这一份，
	//   不波及其它系统可能授予的同名特性（见文件顶部来源标签说明）。
	if(HAS_TRAIT(user, TRAIT_PROSOPAGNOSIA))
		REMOVE_TRAIT(user, TRAIT_PROSOPAGNOSIA, FACIAL_BLINDNESS_TRAIT_SOURCE)


// ============================================================================
// 关于"目标选择/取消"与"错误处理"的说明（对应需求中的通用实现要求）
// ----------------------------------------------------------------------------
// · 目标选择：本恶习是【被动持续型】机制，没有任何需要玩家主动选择目标的环节（不存在施法/
//   选敌/读条），其效果完全由"持有者自身是否带有本恶习"决定。因此不涉及目标选择，也就不存在
//   "需要取消的目标弹窗"。
// · 错误处理（健壮性）：所有路径均包含——空值/类型校验（user/H、ishuman）、死亡跳过、
//   mind 未就绪时的安全降级（?. 安全访问 + 推迟到下次心跳）、特性增删的去重与来源精确匹配、
//   以及"记忆为空时不做无谓清空与提示"的短路。即便某次心跳因时序问题未能处理，下一次心跳
//   也会自然补上（特性兜底补回 + 记忆持续擦除），不会留下不一致的中间态。
// ============================================================================


// ============================================================================
// 登记：把"脸盲症"加入角色定制界面的"可选恶习"列表
// ----------------------------------------------------------------------------
// 为什么需要登记：玩家在创角界面能选到的恶习来自 GLOB.character_flaws（见
//   code/datums/character_flaw/_character_flaw.dm 的 GLOBAL_LIST_INIT 与
//   code/modules/client/vices_menu.dm 的恶习选择区）。该列表是硬编码的，而我们不能修改
//   modular_z121 之外的核心文件，因此改为"运行时追加"。
// 为什么 GLOB.charflaw_singletons 无需手动登记：code/__HELPERS/global_lists.dm 会自动为
//   /datum/charflaw 的【所有子类型】建立单例（subtypesof 遍历），本恶习会被自动纳入，
//   因此只需补登"可选列表"GLOB.character_flaws 即可。
// 为什么提供独立 proc：把"登记动作"封装起来，由同在 modular_z121 内的
//   bootstrap/custom_bootstrap.dm 在其 Initialize 中调用（那是本项目统一的启动钩子，执行
//   时机晚于全局列表初始化，追加安全）。这样登记逻辑与恶习定义同处一文件、内聚清晰。
